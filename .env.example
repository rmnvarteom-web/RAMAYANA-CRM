# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string (Neon, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/ramayana_crm?schema=public"

# Random string, at least 32 characters (used to encrypt session cookies)
SESSION_SECRET="change-me-to-a-random-32-character-string"

# Resend API key for sending invite/OTP/notification emails (resend.com)
RESEND_API_KEY=""
EMAIL_FROM="RAMAYANA CRM <noreply@example.com>"
